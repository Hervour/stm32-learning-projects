// A、在(200,100)位置, 以24*24点阵显示自己的姓名和学号: 白字黑底
//    ★★★ 请把下面两行的姓名和学号改成自己的(本文件必须以 GB2312/GBK 编码保存) ★★★
#define  MY_NAME        " 周泽乐"
#define  MY_ID          "24121980"
#define  MY_NAME_ID     MY_NAME MY_ID
#define  NAME_DISP_X    200        // 姓名学号显示的X坐标
#define  NAME_DISP_Y    100        // 姓名学号显示的Y坐标
// F、在(200,150)显示频率值和占空比值: 白字蓝底
#define  FD_DISP_X      200        // 频率/占空比显示的X坐标
#define  FD_DISP_Y      150        // 频率/占空比显示的Y坐标

/* USER CODE END PD */

